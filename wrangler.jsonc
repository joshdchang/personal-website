{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  // Adding `routes` makes Wrangler disable workers.dev unless it is set here.
  "workers_dev": true,
  // Custom domains live here rather than only in the dashboard, so the set of
  // hostnames this Worker answers on is reviewable and reproducible.
  "routes": [
    { "pattern": "joshdchang.com", "custom_domain": true },
    { "pattern": "www.joshdchang.com", "custom_domain": true },
    { "pattern": "joshchang.co", "custom_domain": true },
    // www.joshchang.co keeps its pre-existing hand-made A/AAAA records, which
    // Cloudflare refuses to replace with a custom domain (API code 100117).
    // Those records are proxied, so a plain route intercepts the request at the
    // edge before the (nonexistent) origin is ever dialled, which is what was
    // producing the 522.
    { "pattern": "www.joshchang.co/*", "zone_name": "joshchang.co" }
  ]
}
